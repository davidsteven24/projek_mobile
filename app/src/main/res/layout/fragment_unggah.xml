<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FBF8"
    tools:context=".UnggahFragment">

    <!-- KONTEN UTAMA DENGAN SCROLLVIEW -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Logo Aplikasi di Header -->
            <ImageView
                android:id="@+id/imgHeaderLogo"
                android:layout_width="120dp"
                android:layout_height="36dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo" />

            <!-- Judul Halaman -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Unggah Karya Baru"
                android:textColor="#1F2937"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Kotak Dropzone / Ketuk untuk unggah foto -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#EAF4EE"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#40826D"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <!-- Ikon Kamera -->
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_menu_camera"
                        app:tint="#40826D" />

                    <!-- Teks Ketuk -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Ketuk untuk unggah foto"
                        android:textColor="#40826D"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Format yang didukung -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Mendukung: JPG, PNG, RAW (Maks. 50MB)"
                        android:textColor="#6B7280"
                        android:textSize="11sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tombol Unggah File Digital -->
            <Button
                android:id="@+id/btnUploadFile"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#40826D"
                android:drawableStart="@android:drawable/ic_menu_upload"
                android:drawablePadding="8dp"
                android:paddingHorizontal="16dp"
                android:text="UNGGAH FILE DIGITAL"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <!-- Input 1: Judul Foto / Karya -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Judul Foto / Karya"
                android:textColor="#374151"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtJudul"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_rounded_input"
                android:hint="Contoh: Senja di Pelabuhan"
                android:inputType="text"
                android:paddingHorizontal="16dp"
                android:textColor="#1F2937"
                android:textColorHint="#9CA3AF"
                android:textSize="14sp" />

            <!-- Input 2: Kategori Genre -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Kategori Genre"
                android:textColor="#374151"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Spinner / Dropdown Kategori -->
            <Spinner
                android:id="@+id/spinnerKategori"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_rounded_input"
                android:paddingHorizontal="12dp" />

            <!-- Input 3: Harga (Rp) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Harga (Rp)"
                android:textColor="#374151"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtHarga"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_rounded_input"
                android:hint="Masukkan Harga (misal: 150.000)"
                android:inputType="number"
                android:paddingHorizontal="16dp"
                android:textColor="#1F2937"
                android:textColorHint="#9CA3AF"
                android:textSize="14sp" />

            <!-- Input 4: Deskripsi & Cerita -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Deskripsi &amp; Cerita (Opsional)"
                android:textColor="#374151"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtDeskripsi"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_rounded_input"
                android:gravity="top|start"
                android:hint="Ceritakan sedikit kisah di balik foto ini..."
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:textColor="#1F2937"
                android:textColorHint="#9CA3AF"
                android:textSize="14sp" />

            <!-- Tombol Publikasikan Karya -->
            <Button
                android:id="@+id/btnPublikasikan"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#40826D"
                android:text="Publikasikan Karya"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <!-- Catatan Hak Cipta -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Pastikan foto karya Anda memiliki hak cipta."
                android:textColor="#6B7280"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>